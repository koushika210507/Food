pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/DivyanshSingh8899/College-Management-System-Python.git'
            }
        }

        stage('Build') {
            steps {
                echo 'Building the Python application...'
                bat 'python --version'
                bat 'pip install -r requirements.txt'
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests...'
                bat 'python -m unittest discover'
            }
        }
    }
}
